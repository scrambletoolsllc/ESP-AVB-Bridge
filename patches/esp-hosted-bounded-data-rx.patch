@@ -177,7 +178,13 @@
 		mempool->memset(mem, 0, nbytes);
 
 	if (!mem) {
-		ESP_LOGE(TAG, "mempool %p alloc failed nbytes[%u]", mempool, nbytes);
+		/* Rate-limited: a caller that drops on failure can fail at its
+		 * packet rate, and a console line per failure stalls it. */
+		static uint32_t alloc_failures;
+		if ((alloc_failures++ & 0xFF) == 0) {
+			ESP_LOGE(TAG, "mempool %p alloc failed nbytes[%u] (%" PRIu32 " failures)",
+					mempool, nbytes, alloc_failures);
+		}
 	}
 	return mem;
 }
