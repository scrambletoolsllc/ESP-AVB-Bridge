--- a/slave/main/sdio_slave_api.c
+++ b/slave/main/sdio_slave_api.c
@@ -9,6 +9,8 @@
 #include <string.h>
 #include <unistd.h>
 #include "esp_log.h"
+#include "esp_system.h"
+#include "esp_timer.h"
 #include "esp_hosted_log.h"
 #include "interface.h"
 #include "sdio_slave_api.h"
@@ -521,6 +523,38 @@
 	return ESP_OK;
 }
 
+#if !SIMPLIFIED_SDIO_SLAVE
+/* Data frames never wait for the host. The AP's receive callback calls
+ * sdio_write on the Wi-Fi task, so waiting for a send slot stalls the
+ * whole AP (beacons, block acks) whenever the host falls behind, and a
+ * console line per dropped frame stalls it the same way. A data frame
+ * takes a slot only while more than SDIO_CONTROL_RESERVE remain, which
+ * keeps one free for RPC and event traffic; past that it is dropped and
+ * counted. */
+#define SDIO_CONTROL_RESERVE        2
+#define SDIO_DROP_REPORT_US         10000000
+
+static uint32_t sdio_data_sent;
+static uint32_t sdio_data_dropped;
+static int64_t sdio_drop_report_at_us;
+
+static void sdio_note_data_drop(void)
+{
+	sdio_data_dropped++;
+	int64_t now_us = esp_timer_get_time();
+	if (now_us < sdio_drop_report_at_us) {
+		return;
+	}
+	ESP_LOGW(TAG, "host behind: %" PRIu32 " of %" PRIu32 " data frames dropped, "
+			"free heap %" PRIu32 " (min %" PRIu32 ")",
+			sdio_data_dropped, sdio_data_dropped + sdio_data_sent,
+			esp_get_free_heap_size(), esp_get_minimum_free_heap_size());
+	sdio_data_dropped = 0;
+	sdio_data_sent = 0;
+	sdio_drop_report_at_us = now_us + SDIO_DROP_REPORT_US;
+}
+#endif
+
 static int32_t sdio_write(interface_handle_t *handle, interface_buffer_handle_t *buf_handle)
 {
 	uint32_t total_len = 0;
@@ -550,8 +584,26 @@
 
 	total_len = buf_handle->payload_len + offset;
 
+#if !SIMPLIFIED_SDIO_SLAVE
+	bool is_data = buf_handle->if_type == ESP_STA_IF ||
+		buf_handle->if_type == ESP_AP_IF;
+	if (is_data &&
+	    (uxSemaphoreGetCount(sdio_send_queue_sem) <= SDIO_CONTROL_RESERVE ||
+	     xSemaphoreTake(sdio_send_queue_sem, 0) != pdTRUE)) {
+		sdio_note_data_drop();
+		return ESP_FAIL;
+	}
+#endif
+
 	sendbuf = sdio_buffer_tx_alloc(total_len, MEMSET_REQUIRED);
 	if (sendbuf == NULL) {
+#if !SIMPLIFIED_SDIO_SLAVE
+		if (is_data) {
+			xSemaphoreGive(sdio_send_queue_sem);
+			sdio_note_data_drop();
+			return ESP_FAIL;
+		}
+#endif
 		ESP_LOGE(TAG, "send buffer[%"PRIu32"] malloc fail", total_len);
 		return ESP_FAIL;
 	}
@@ -562,7 +614,7 @@
 	ESP_HEXLOGV("bus_tx", sendbuf, total_len, 32);
 
 #if !SIMPLIFIED_SDIO_SLAVE
-	if (xSemaphoreTake(sdio_send_queue_sem, portMAX_DELAY) != pdTRUE) {
+	if (!is_data && xSemaphoreTake(sdio_send_queue_sem, portMAX_DELAY) != pdTRUE) {
 		sdio_buffer_tx_free(sendbuf);
 		return ESP_FAIL;
 	}
@@ -581,6 +633,10 @@
 
 #if SIMPLIFIED_SDIO_SLAVE
 	sdio_buffer_tx_free(sendbuf);
+#else
+	if (is_data) {
+		sdio_data_sent++;
+	}
 #endif
 
