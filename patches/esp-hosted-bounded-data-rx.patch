--- a/coprocessor/eh_cp_transport/src/eh_cp_transport_sdio.c
+++ b/coprocessor/eh_cp_transport/src/eh_cp_transport_sdio.c
@@ -12,6 +12,7 @@
 #include "freertos/semphr.h"
 #include "esp_log.h"
 #include "esp_system.h"
+#include "esp_timer.h"
 #include "esp_heap_caps.h"
 #include "eh_log.h"
 #include "eh_transport_cp.h"
@@ -495,6 +496,34 @@
 
 #endif
 
+/* Data frames never wait for the host. The AP's receive callback calls
+ * sdio_write on the Wi-Fi task, so waiting for queue space stalls the
+ * whole AP (beacons, block acks) whenever the host falls behind, and a
+ * console line per dropped frame stalls it the same way. A data frame
+ * that finds the queue full is dropped and counted; control and events
+ * have their own queues. */
+#define SDIO_DROP_REPORT_US 10000000
+
+static uint32_t sdio_data_sent;
+static uint32_t sdio_data_dropped;
+static int64_t sdio_drop_report_at_us;
+
+static void sdio_note_data_drop(void)
+{
+	sdio_data_dropped++;
+	int64_t now_us = esp_timer_get_time();
+	if (now_us < sdio_drop_report_at_us) {
+		return;
+	}
+	ESP_LOGW(TAG, "host behind: %" PRIu32 " of %" PRIu32 " data frames dropped, "
+			"free heap %" PRIu32 " (min %" PRIu32 ")",
+			sdio_data_dropped, sdio_data_dropped + sdio_data_sent,
+			esp_get_free_heap_size(), esp_get_minimum_free_heap_size());
+	sdio_data_dropped = 0;
+	sdio_data_sent = 0;
+	sdio_drop_report_at_us = now_us + SDIO_DROP_REPORT_US;
+}
+
 /* if_ops->write: enqueue only. Ownership of buf_handle transfers to the queue;
  * the send_task frees it after packing. */
 static int32_t sdio_write(interface_handle_t *handle, interface_buffer_handle_t *buf_handle)
@@ -535,10 +564,15 @@
 	prio = (q.if_type == ESP_SERIAL_IF) ? PRIO_Q_SERIAL :
 	       (q.if_type == ESP_HCI_IF)    ? PRIO_Q_BT : PRIO_Q_OTHERS;
 
-	if (xQueueSend(to_host_queue[prio], &q, portMAX_DELAY) != pdTRUE) {
+	bool is_data = prio == PRIO_Q_OTHERS;
+	if (xQueueSend(to_host_queue[prio], &q, is_data ? 0 : portMAX_DELAY) != pdTRUE) {
 		free_tx_buf(&q);
+		if (is_data)
+			sdio_note_data_drop();
 		return ESP_FAIL;
 	}
+	if (is_data)
+		sdio_data_sent++;
 	send_task_notify();
 	return buf_handle->payload_len;
 }
