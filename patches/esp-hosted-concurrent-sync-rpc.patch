+
+/* Detach before deletion so late responses cannot signal freed storage. */
+static ctrl_cmd_t *take_sync_response(ctrl_cmd_t *app_req)
+{
+	ctrl_cmd_t *response = NULL;
+	void *sem = app_req->rx_sem;
+	portENTER_CRITICAL(&sync_rsp_lock);
+	for (int index = 0; index < MAX_SYNC_RPC_TRANSACTIONS; ++index) {
+		sync_rsp_t *slot = &sync_rsp_table[index];
+		if (slot->uid == app_req->uid && slot->sem == sem) {
+			response = slot->response;
+			memset(slot, 0, sizeof(*slot));
+			break;
+		}
+	}
+	app_req->rx_sem = NULL;
+	portEXIT_CRITICAL(&sync_rsp_lock);
+	if (sem)
+		g_h.funcs->_h_destroy_semaphore(sem);
+	return response;
 }
 
