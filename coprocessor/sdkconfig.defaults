CONFIG_IDF_TARGET="esp32c6"

# esp-hosted coprocessor for an MCU host over SDIO, RPC v2, with Wi-Fi and
# peer data (esp_hosted_avb's messages).
CONFIG_ESP_HOSTED=y
CONFIG_ESP_HOSTED_CP=y
CONFIG_ESP_HOSTED_CP_FOR_MCU=y
CONFIG_ESP_HOSTED_CP_RPC_V2=y
CONFIG_ESP_HOSTED_CP_FEAT_WIFI=y
CONFIG_ESP_HOSTED_CP_FEAT_PEER_DATA=y
CONFIG_EH_TRANSPORT_CP_SDIO=y
CONFIG_HOSTED_AVB_BUILD_COPROCESSOR_HANDLER=y

# The bridge uses no Bluetooth.
CONFIG_BT_ENABLED=n
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_WIFI_IRAM_OPT=y
CONFIG_ESP_WIFI_RX_IRAM_OPT=y

# Bring-up diagnostics: verbose bootloader logs on the coprocessor's
# UART0 so flash/boot issues are visible without rebuilding. Bootloader
# output is boot-only, so it costs nothing in steady state.
CONFIG_BOOTLOADER_LOG_LEVEL_VERBOSE=y
# Runtime log level is INFO, NOT DEBUG. At DEBUG the coprocessor
# hex-dumps every bus_RX packet to UART0; at 115200 baud that alone caps
# the Wi-Fi data path at a few tens of packets/s. UART TX blocks whether
# or not anything is listening on the wire, so this throttles the bridge
# in normal operation, not just when a console is attached.
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# FTM: responder on the SoftAP per IEEE 802.1AS-2020 §12.1.2. STAs
# initiate FTM bursts against the AP; this side must respond.
# Required so the STA's ptpd_inject_peer_delay path gets RTT samples.
CONFIG_ESP_WIFI_FTM_ENABLE=y
CONFIG_ESP_WIFI_FTM_RESPONDER_SUPPORT=y

# Wider A-MPDU TX BA window for bridging AVTP from wired to Wi-Fi. C6
# supports HE (Wi-Fi 6) so the Kconfig range is 2..64; the default of
# 6 keeps per-MPDU overhead high. 64 lets the aggregator pack a full
# Class A burst into one PHY transmission.
CONFIG_ESP_WIFI_TX_BA_WIN=64
# More dynamic TX buffers so the aggregator has room to accumulate
# before the BA window forces a send.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=64
# Discard a host frame at once when the TX buffer pool is full. The
# default waits 1 ms up to 16 times per frame while every host frame
# behind it waits too, which stalled the bus and the bridge's control
# frames whenever poor air kept the pool full.
CONFIG_ESP_HOSTED_CP_WIFI_TX_RETRY_LIMIT=1
# Match RX BA window to TX. Block-Ack negotiation locks the lower of
# the two endpoints' BA windows; without bumping the RX side too the
# AP's TX_BA_WIN=64 collapses to the peer's RX_BA_WIN=6 default.
# The host's Wi-Fi init overrides the RX window and both RX buffer
# counts at runtime (its CONFIG_WIFI_RMT_* values), so these only
# apply when no host sets them.
CONFIG_ESP_WIFI_RX_BA_WIN=64
# RX_BA_WIN=64 requires DYNAMIC_RX_BUFFER_NUM >= 64 and
# STATIC_RX_BUFFER_NUM * 2 >= 64; IDF's wifi_init.c #errors otherwise.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
